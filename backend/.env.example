# Database Configuration
# For Windows Authentication, set DB_TRUSTED_CONNECTION=true
# For SQL Server Authentication, set DB_TRUSTED_CONNECTION=false and provide DB_USER/DB_PASSWORD

DB_SERVER=.
DB_PORT=1433
DB_DATABASE=IoT_Database
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=false

# SQL Server Authentication (uncomment if not using Windows Authentication)
# DB_USER=your_username
# DB_PASSWORD=your_password

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: JWT Secret for authentication (if needed)
# JWT_SECRET=your_jwt_secret_key_here
# JWT_EXPIRES_IN=7d